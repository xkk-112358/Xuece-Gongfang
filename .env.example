# ==================== 学测工坊 环境变量示例 ====================
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交到版本库！

# Django 密钥（必填，生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"）
DJANGO_SECRET_KEY=your-secret-key-here

# 调试模式：开发环境 True，生产环境必须为 False
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔（生产环境填你的域名，如 your-domain.com,www.your-domain.com）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL 参数加密密钥（Fernet，必填）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：更换此密钥会导致已收藏/已分享的加密链接全部失效
URL_ENCRYPTION_KEY=your-fernet-key-here

# MySQL 数据库配置（DB_PASSWORD 必填）
DB_NAME=xuecegongfang
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# AI 模型 API 密钥（可选，用于 manage.py retag_all 等内置命令）
DEEPSEEK_API_KEY=your-deepseek-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
